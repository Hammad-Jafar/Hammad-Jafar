/**
 * ============================================================
 * PRODUCT GRID POPUP
 * ============================================================
 *
 * Responsibilities:
 *
 * 1. Open product modal
 * 2. Load Shopify product JSON
 * 3. Render product information
 * 4. Render dynamic colors
 * 5. Render dynamic size dropdown
 * 6. Select correct variant
 * 7. Update product image
 * 8. Update product price
 * 9. Animate selected color
 * 10. Add selected variant to cart
 * 11. Black + Medium -> add accessory product
 * 12. Refresh Dawn cart drawer
 * 13. Refresh Dawn cart icon
 *
 * IMPORTANT:
 *
 * This JavaScript DOES NOT modify the product grid.
 *
 * ============================================================
 */

(() => {
  "use strict";


  /* ============================================================
     INITIALIZATION
     ============================================================ */

  function initializeProductGrid() {

    const modal = document.querySelector(
      ".custom-product-modal"
    );

    if (!modal) {
      return;
    }


    /*
     * Prevent duplicate initialization.
     */

    if (modal.dataset.initialized === "true") {
      return;
    }

    modal.dataset.initialized = "true";


    /* ==========================================================
       DOM ELEMENTS
       ========================================================== */

    const closeButton =
      modal.querySelector(
        ".custom-product-modal-close"
      );

    const modalImage =
      modal.querySelector(
        ".custom-modal-image"
      );

    const modalTitle =
      modal.querySelector(
        ".custom-modal-title"
      );

    const modalPrice =
      modal.querySelector(
        ".custom-modal-price"
      );

    const modalDescription =
      modal.querySelector(
        ".custom-modal-description"
      );

    const colorWrapper =
      modal.querySelector(
        ".custom-modal-color-wrapper"
      );

    const colorContainer =
      modal.querySelector(
        ".custom-modal-colors"
      );

    const colorSlider =
      modal.querySelector(
        ".custom-color-slider"
      );

    const sizeWrapper =
      modal.querySelector(
        ".custom-modal-size-wrapper"
      );

    const sizeSelect =
      modal.querySelector(
        ".custom-modal-size-select"
      );

    const addToCartButton =
      modal.querySelector(
        ".custom-modal-add-to-cart"
      );

    const message =
      modal.querySelector(
        ".custom-modal-message"
      );


    /* ==========================================================
       STATE
       ========================================================== */

    let currentProduct = null;

    let currentVariants = [];

    let selectedOptions = {};

    let selectedVariant = null;


    /* ==========================================================
       OPEN BUTTONS
       ========================================================== */

    const openButtons =
      document.querySelectorAll(
        ".custom-product-open"
      );


    openButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          const handle =
            button.dataset.productHandle;

          if (!handle) {
            return;
          }

          openProduct(handle);

        }
      );

    });


    /* ==========================================================
       OPEN PRODUCT
       ========================================================== */

    async function openProduct(handle) {

      try {

        resetModal();

        showModal();


        /*
         * Shopify Ajax Product API.
         *
         * No GraphQL.
         */

        const response =
          await fetch(
            `/products/${encodeURIComponent(handle)}.js`
          );


        if (!response.ok) {

          throw new Error(
            `Product request failed: ${response.status}`
          );

        }


        const product =
          await response.json();


        currentProduct = product;

        currentVariants =
          product.variants || [];


        renderProduct(product);

        selectInitialVariant();


      } catch (error) {

        console.error(
          "Product modal error:",
          error
        );

        showMessage(
          "Unable to load this product.",
          true
        );

      }

    }


    /* ==========================================================
       RENDER PRODUCT
       ========================================================== */

    function renderProduct(product) {


      /*
       * Product image
       */

      if (product.featured_image) {

        modalImage.src =
          product.featured_image;

      } else {

        modalImage.removeAttribute(
          "src"
        );

      }


      modalImage.alt =
        product.title || "";


      /*
       * Product title
       */

      modalTitle.textContent =
        product.title || "";


      /*
       * Product price
       */

      if (product.price != null) {

        modalPrice.textContent =
          formatMoney(product.price);

      }


      /*
       * Product description
       */

      modalDescription.innerHTML =
        product.description || "";


      /*
       * Options
       */

      renderOptionGroups(product);

    }


    /* ==========================================================
       FIND COLOR OPTION
       ========================================================== */

    function getColorOption(product) {

      return findOption(
        product,
        [
          "color",
          "colour",
          "shade",
          "finish"
        ]
      );

    }


    /* ==========================================================
       FIND SIZE OPTION
       ========================================================== */

    function getSizeOption(product) {

      return findOption(
        product,
        [
          "size"
        ]
      );

    }


    /* ==========================================================
       FIND OPTION
       ========================================================== */

    function findOption(
      product,
      names
    ) {

      if (!product.options) {
        return null;
      }


      return (
        product.options.find(
          (option) => {

            const optionName =
              String(
                option.name
              )
                .trim()
                .toLowerCase();


            return names.includes(
              optionName
            );

          }
        ) || null
      );

    }


    /* ==========================================================
       RENDER OPTION GROUPS
       ========================================================== */

    function renderOptionGroups(
      product
    ) {


      /*
       * Clear old color buttons.
       */

      colorContainer
        .querySelectorAll(
          ".custom-color-button"
        )
        .forEach(
          (button) => {
            button.remove();
          }
        );


      /*
       * Reset size dropdown.
       */

      sizeSelect.innerHTML = "";


      /*
       * Add default size option.
       */

      const defaultSizeOption =
        document.createElement(
          "option"
        );

      defaultSizeOption.value = "";

      defaultSizeOption.textContent =
        "Select Size";


      sizeSelect.appendChild(
        defaultSizeOption
      );


      /* ========================================================
         COLOR
         ======================================================== */

      const colorOption =
        getColorOption(product);


      if (
        colorOption &&
        colorOption.values &&
        colorOption.values.length
      ) {

        colorWrapper.style.display =
          "block";


        colorOption.values.forEach(
          (
            value,
            index
          ) => {

            const button =
              document.createElement(
                "button"
              );


            button.type =
              "button";


            button.className =
              "custom-color-button";


            button.dataset.optionName =
              colorOption.name;


            button.dataset.optionValue =
              value;


            button.textContent =
              value;


            button.style.cssText = `
              position: relative;
              z-index: 1;
              height: 42px;
              padding: 0 18px;
              border: 1px solid #000000;
              background: transparent;
              color: #000000;
              font-size: 14px;
              cursor: pointer;
              transition: color 0.25s ease;
            `;


            button.addEventListener(
              "click",
              () => {

                selectedOptions[
                  colorOption.name
                ] = value;


                /*
                 * When color changes,
                 * automatically choose a
                 * compatible size if possible.
                 */

                const compatibleVariant =
                  findCompatibleVariant(
                    colorOption.name,
                    value
                  );


                if (
                  compatibleVariant
                ) {

                  applyVariantOptions(
                    compatibleVariant
                  );

                }


                updateVariant();

                animateColorSlider(
                  button
                );

                updateOptionStates();

              }
            );


            colorContainer.appendChild(
              button
            );


            /*
             * First color becomes
             * initial color.
             */

            if (index === 0) {

              selectedOptions[
                colorOption.name
              ] = value;

            }

          }
        );


        /*
         * Position slider after DOM
         * has calculated button widths.
         */

        requestAnimationFrame(
          () => {

            const firstButton =
              colorContainer.querySelector(
                ".custom-color-button"
              );


            if (firstButton) {

              animateColorSlider(
                firstButton,
                false
              );

            }

          }
        );


      } else {

        colorWrapper.style.display =
          "none";

      }


      /* ========================================================
         SIZE DROPDOWN
         ======================================================== */

      const sizeOption =
        getSizeOption(product);


      if (
        sizeOption &&
        sizeOption.values &&
        sizeOption.values.length
      ) {

        sizeWrapper.style.display =
          "block";


        sizeOption.values.forEach(
          (value) => {

            const option =
              document.createElement(
                "option"
              );


            option.value =
              value;


            option.textContent =
              value;


            sizeSelect.appendChild(
              option
            );

          }
        );


        /*
         * Size changed by user.
         */

        sizeSelect.onchange =
          () => {

            const value =
              sizeSelect.value;


            if (!value) {
              return;
            }


            selectedOptions[
              sizeOption.name
            ] = value;


            updateVariant();

            updateOptionStates();

          };


      } else {

        sizeWrapper.style.display =
          "none";

      }


      updateOptionStates();

    }


    /* ==========================================================
       FIND COMPATIBLE VARIANT
       ========================================================== */

    function findCompatibleVariant(
      changedOptionName,
      changedValue
    ) {

      return currentVariants.find(
        (variant) => {

          if (!variant.available) {
            return false;
          }


          if (!currentProduct.options) {
            return false;
          }


          return currentProduct.options.every(
            (
              option,
              index
            ) => {

              const optionValue =
                variant[
                  `option${index + 1}`
                ];


              /*
               * Changed option must match.
               */

              if (
                option.name ===
                changedOptionName
              ) {

                return (
                  optionValue ===
                  changedValue
                );

              }


              /*
               * Other already selected
               * options must match.
               */

              const selected =
                selectedOptions[
                  option.name
                ];


              if (!selected) {
                return true;
              }


              return (
                optionValue ===
                selected
              );

            }
          );

        }
      ) || null;

    }


    /* ==========================================================
       APPLY VARIANT OPTIONS
       ========================================================== */

    function applyVariantOptions(
      variant
    ) {

      if (
        !variant ||
        !currentProduct ||
        !currentProduct.options
      ) {

        return;

      }


      currentProduct.options.forEach(
        (
          option,
          index
        ) => {

          const value =
            variant[
              `option${index + 1}`
            ];


          if (value) {

            selectedOptions[
              option.name
            ] = value;

          }

        }
      );


      updateSizeDropdown();

    }


    /* ==========================================================
       UPDATE SIZE DROPDOWN
       ========================================================== */

    function updateSizeDropdown() {

      const sizeOption =
        getSizeOption(
          currentProduct
        );


      if (!sizeOption) {
        return;
      }


      const selected =
        selectedOptions[
          sizeOption.name
        ];


      if (selected) {

        sizeSelect.value =
          selected;

      } else {

        sizeSelect.value = "";

      }

    }


    /* ==========================================================
       SELECT INITIAL VARIANT
       ========================================================== */

    function selectInitialVariant() {

      if (!currentVariants.length) {

        selectedVariant =
          null;

        return;

      }


      /*
       * First available variant.
       */

      const availableVariant =
        currentVariants.find(
          (variant) =>
            variant.available
        );


      if (!availableVariant) {

        selectedVariant =
          currentVariants[0];

        return;

      }


      selectedVariant =
        availableVariant;


      /*
       * Load options from the
       * selected variant.
       */

      applyVariantOptions(
        availableVariant
      );


      /*
       * Update UI.
       */

      updateVariant();

      updateOptionStates();

      positionColorSliderFromState();

    }


    /* ==========================================================
       UPDATE VARIANT
       ========================================================== */

    function updateVariant() {

      if (
        !currentVariants.length ||
        !currentProduct
      ) {

        return;

      }


      const matchingVariant =
        currentVariants.find(
          (variant) => {

            if (!currentProduct.options) {
              return false;
            }


            return currentProduct.options.every(
              (
                option,
                index
              ) => {

                const selected =
                  selectedOptions[
                    option.name
                  ];


                /*
                 * If option has not been
                 * selected, don't reject
                 * the variant.
                 */

                if (!selected) {
                  return true;
                }


                return (
                  variant[
                    `option${index + 1}`
                  ] === selected
                );

              }
            );

          }
        );


      if (matchingVariant) {

        selectedVariant =
          matchingVariant;


        /*
         * Update product image.
         */

        if (
          matchingVariant.featured_image
        ) {

          modalImage.src =
            matchingVariant.featured_image.src;

        }


        /*
         * Update price.
         */

        if (
          matchingVariant.price != null
        ) {

          modalPrice.textContent =
            formatMoney(
              matchingVariant.price
            );

        }


        /*
         * Availability.
         */

        if (
          !matchingVariant.available
        ) {

          addToCartButton.disabled =
            true;

          addToCartButton.textContent =
            "Sold Out";

        } else {

          addToCartButton.disabled =
            false;

          addToCartButton.textContent =
            "Add to Cart";

        }


      } else {

        selectedVariant =
          null;


        addToCartButton.disabled =
          true;


        addToCartButton.textContent =
          "Variant Unavailable";

      }


      updateSizeDropdown();

    }


    /* ==========================================================
       UPDATE OPTION STATES
       ========================================================== */

    function updateOptionStates() {


      /*
       * COLOR BUTTONS
       */

      colorContainer
        .querySelectorAll(
          ".custom-color-button"
        )
        .forEach(
          (button) => {

            const value =
              button.dataset.optionValue;


            const optionName =
              button.dataset.optionName;


            const selected =
              selectedOptions[
                optionName
              ] === value;


            button.style.color =
              selected
                ? "#ffffff"
                : "#000000";

          }
        );


      /*
       * SIZE SELECT
       */

      const sizeOption =
        getSizeOption(
          currentProduct
        );


      if (
        sizeOption &&
        selectedOptions[
          sizeOption.name
        ]
      ) {

        sizeSelect.value =
          selectedOptions[
            sizeOption.name
          ];

      }

    }


    /* ==========================================================
       COLOR SLIDER
       ========================================================== */

    function animateColorSlider(
      button,
      animate = true
    ) {

      if (
        !button ||
        !colorSlider
      ) {

        return;

      }


      const x =
        button.offsetLeft;


      const y =
        button.offsetTop;


      colorSlider.style.width =
        `${button.offsetWidth}px`;


      if (!animate) {

        colorSlider.style.transition =
          "none";

      } else {

        colorSlider.style.transition =
          "transform 0.35s ease, width 0.35s ease";

      }


      colorSlider.style.transform =
        `translate(${x}px, ${y}px)`;


      if (!animate) {

        requestAnimationFrame(
          () => {

            colorSlider.style.transition =
              "transform 0.35s ease, width 0.35s ease";

          }
        );

      }

    }


    /* ==========================================================
       POSITION COLOR SLIDER
       ========================================================== */

    function positionColorSliderFromState() {

      if (!currentProduct) {
        return;
      }


      const colorOption =
        getColorOption(
          currentProduct
        );


      if (!colorOption) {
        return;
      }


      const selected =
        selectedOptions[
          colorOption.name
        ];


      const button =
        Array.from(
          colorContainer.querySelectorAll(
            ".custom-color-button"
          )
        ).find(
          (item) =>
            item.dataset.optionValue ===
            selected
        );


      if (button) {

        requestAnimationFrame(
          () => {

            animateColorSlider(
              button,
              false
            );

          }
        );

      }

    }


    /* ==========================================================
       ADD TO CART
       ========================================================== */

    addToCartButton.addEventListener(
      "click",
      async () => {

        if (!selectedVariant) {

          showMessage(
            "Please select a valid variant.",
            true
          );

          return;

        }


        if (
          !selectedVariant.available
        ) {

          showMessage(
            "This variant is sold out.",
            true
          );

          return;

        }


        try {

          addToCartButton.disabled =
            true;


          addToCartButton.textContent =
            "Adding...";


          /*
           * Add main product.
           */

          await addVariantToCart(
            selectedVariant.id,
            1
          );


          /*
           * Black + Medium:
           * automatically add accessory.
           */

          if (
            isBlackMediumSelection()
          ) {

            await addAccessoryProduct();

          }


          /*
           * Refresh Dawn cart.
           */

          await refreshDawnCart();


          showMessage(
            "Added to cart.",
            false
          );


          addToCartButton.textContent =
            "Added";


          setTimeout(
            () => {

              closeModal();

            },
            700
          );


        } catch (error) {

          console.error(
            "Add to cart error:",
            error
          );


          showMessage(
            "Unable to add product to cart.",
            true
          );


          addToCartButton.disabled =
            false;


          addToCartButton.textContent =
            "Add to Cart";

        }

      }
    );


    /* ==========================================================
       ADD VARIANT TO CART
       ========================================================== */

    async function addVariantToCart(
      variantId,
      quantity
    ) {

      const root =
        window.Shopify?.routes?.root ||
        "/";


      const response =
        await fetch(
          `${root}cart/add.js`,
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              Accept:
                "application/json"
            },

            body:
              JSON.stringify({
                items: [
                  {
                    id: Number(
                      variantId
                    ),

                    quantity:
                      quantity
                  }
                ]
              })
          }
        );


      if (!response.ok) {

        const error =
          await response
            .json()
            .catch(
              () => ({})
            );


        throw new Error(
          error.description ||
          "Cart request failed"
        );

      }


      return response.json();

    }


    /* ==========================================================
       BLACK + MEDIUM CHECK
       ========================================================== */

    function isBlackMediumSelection() {

      if (!currentProduct) {
        return false;
      }


      const colorOption =
        getColorOption(
          currentProduct
        );


      const sizeOption =
        getSizeOption(
          currentProduct
        );


      if (
        !colorOption ||
        !sizeOption
      ) {

        return false;

      }


      const color =
        String(
          selectedOptions[
            colorOption.name
          ] || ""
        )
          .trim()
          .toLowerCase();


      const size =
        String(
          selectedOptions[
            sizeOption.name
          ] || ""
        )
          .trim()
          .toLowerCase();


      return (
        color === "black" &&
        size === "medium"
      );

    }


    /* ==========================================================
       ADD ACCESSORY PRODUCT
       ========================================================== */

    async function addAccessoryProduct() {

      const section =
        document.querySelector(
          "[id^='product-grid-']"
        );


      const accessoryHandle =
        section?.dataset.accessoryHandle ||
        "soft-winter-jacket";


      if (!accessoryHandle) {
        return;
      }


      const response =
        await fetch(
          `/products/${encodeURIComponent(
            accessoryHandle
          )}.js`
        );


      if (!response.ok) {

        console.warn(
          "Accessory product could not be found:",
          accessoryHandle
        );

        return;

      }


      const accessory =
        await response.json();


      /*
       * Select first available
       * accessory variant.
       */

      const accessoryVariant =
        (
          accessory.variants ||
          []
        ).find(
          (variant) =>
            variant.available
        );


      if (!accessoryVariant) {

        console.warn(
          "Accessory has no available variant."
        );

        return;

      }


      await addVariantToCart(
        accessoryVariant.id,
        1
      );

    }


    /* ==========================================================
       REFRESH DAWN CART
       ========================================================== */

    async function refreshDawnCart() {

      try {

        const response =
          await fetch(
            `/?sections=cart-drawer,cart-icon-bubble`,
            {
              headers: {
                Accept:
                  "application/json"
              }
            }
          );


        if (!response.ok) {
          return;
        }


        const sections =
          await response.json();


        /* ======================================================
           CART DRAWER
           ====================================================== */

        if (
          sections["cart-drawer"]
        ) {

          const parser =
            new DOMParser();


          const drawerDocument =
            parser.parseFromString(
              sections["cart-drawer"],
              "text/html"
            );


          const newDrawer =
            drawerDocument.querySelector(
              "cart-drawer"
            );


          const currentDrawer =
            document.querySelector(
              "cart-drawer"
            );


          if (
            newDrawer &&
            currentDrawer
          ) {

            currentDrawer.replaceWith(
              newDrawer
            );

          }

        }


        /* ======================================================
           CART ICON
           ====================================================== */

        if (
          sections["cart-icon-bubble"]
        ) {

          const parser =
            new DOMParser();


          const iconDocument =
            parser.parseFromString(
              sections[
                "cart-icon-bubble"
              ],
              "text/html"
            );


          const newIcon =
            iconDocument.querySelector(
              "#cart-icon-bubble"
            );


          const currentIcon =
            document.querySelector(
              "#cart-icon-bubble"
            );


          if (
            newIcon &&
            currentIcon
          ) {

            currentIcon.replaceWith(
              newIcon
            );

          }

        }


        /* ======================================================
           OPEN DAWN CART
           ====================================================== */

        const drawer =
          document.querySelector(
            "cart-drawer"
          );


        if (drawer) {

          if (
            typeof drawer.open ===
            "function"
          ) {

            drawer.open();

          } else {

            drawer.classList.add(
              "active"
            );

            drawer.setAttribute(
              "open",
              ""
            );

          }

        }

      } catch (error) {

        console.error(
          "Cart refresh error:",
          error
        );

      }

    }


    /* ==========================================================
       SHOW MODAL
       ========================================================== */

    function showModal() {

      modal.style.display =
        "flex";


      modal.setAttribute(
        "aria-hidden",
        "false"
      );


      document.body.style.overflow =
        "hidden";

    }


    /* ==========================================================
       CLOSE MODAL
       ========================================================== */

    function closeModal() {

      modal.style.display =
        "none";


      modal.setAttribute(
        "aria-hidden",
        "true"
      );


      document.body.style.overflow =
        "";

    }


    /* ==========================================================
       RESET MODAL
       ========================================================== */

    function resetModal() {

      currentProduct =
        null;


      currentVariants =
        [];


      selectedOptions =
        {};


      selectedVariant =
        null;


      /*
       * Reset image.
       */

      modalImage.removeAttribute(
        "src"
      );


      modalImage.alt =
        "";


      /*
       * Reset text.
       */

      modalTitle.textContent =
        "";


      modalPrice.textContent =
        "";


      modalDescription.innerHTML =
        "";


      /*
       * Reset colors.
       */

      colorContainer
        .querySelectorAll(
          ".custom-color-button"
        )
        .forEach(
          (button) => {
            button.remove();
          }
        );


      /*
       * Reset size dropdown.
       */

      sizeSelect.innerHTML =
        "";


      const defaultOption =
        document.createElement(
          "option"
        );


      defaultOption.value =
        "";


      defaultOption.textContent =
        "Select Size";


      sizeSelect.appendChild(
        defaultOption
      );


      /*
       * Hide option wrappers.
       */

      colorWrapper.style.display =
        "none";


      sizeWrapper.style.display =
        "none";


      /*
       * Hide message.
       */

      message.style.display =
        "none";


      message.textContent =
        "";


      /*
       * Reset Add to Cart.
       */

      addToCartButton.disabled =
        false;


      addToCartButton.textContent =
        "Add to Cart";


      /*
       * Reset color slider.
       */

      colorSlider.style.width =
        "0";


      colorSlider.style.transform =
        "translate(0, 0)";

    }


    /* ==========================================================
       CLOSE BUTTON
       ========================================================== */

    closeButton.addEventListener(
      "click",
      closeModal
    );


    /* ==========================================================
       CLICK OUTSIDE MODAL
       ========================================================== */

    modal.addEventListener(
      "click",
      (event) => {

        if (
          event.target === modal
        ) {

          closeModal();

        }

      }
    );


    /* ==========================================================
       ESCAPE KEY
       ========================================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape" &&
          modal.style.display === "flex"
        ) {

          closeModal();

        }

      }
    );


    /* ==========================================================
       MESSAGE
       ========================================================== */

    function showMessage(
      text,
      error
    ) {

      message.textContent =
        text;


      message.style.display =
        "block";


      message.style.color =
        error
          ? "#c00"
          : "#008000";

    }


    /* ==========================================================
       FORMAT MONEY
       ========================================================== */

    function formatMoney(
      cents
    ) {

      const amount =
        Number(cents) / 100;


      const currency =
        window.Shopify?.currency?.active ||
        "USD";


      return new Intl.NumberFormat(
        document.documentElement.lang ||
          "en-US",
        {
          style: "currency",

          currency:
            currency
        }
      ).format(
        amount
      );

    }

  }


  /* ============================================================
     INITIALIZE
     ============================================================ */

  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initializeProductGrid
    );

  } else {

    initializeProductGrid();

  }

})();